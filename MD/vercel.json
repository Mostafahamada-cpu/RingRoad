{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "comment": "Public client view routing. /property/RR-1024 must open the property details page directly, so the four public routes are rewritten (not redirected) onto client/index.html. Nothing here touches /platform/* — the admin & agent workspace keeps serving exactly as before.",
  "rewrites": [
    { "source": "/property/:code", "destination": "/client/index.html" },
    { "source": "/properties", "destination": "/client/index.html" },
    { "source": "/favorites", "destination": "/client/index.html" },
    { "source": "/compare", "destination": "/client/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(css|js|svg)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    }
  ]
}
